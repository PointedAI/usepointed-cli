  },
  "keywords": [
    "pointed",
    "cli",
    "customer-stories",
    "survey",
    "story-templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
